# Tripo AI — https://platform.tripo3d.ai/ で発行
TRIPO_API_KEY=tsk_xxx
# 海外向けエンドポイント（SDK 既定は中国向け .com → 401 になる）
TRIPO_BASE=https://openapi.tripo3d.ai/v3

# ComfyUI（省略時 http://127.0.0.1:8188）
# COMFY_URL=http://127.0.0.1:8188

# Blender 実行ファイル（省略時は PATH → C:\Program Files\Blender Foundation\Blender */blender.exe の最新）
# BLENDER=C:\Program Files\Blender Foundation\Blender 5.2\blender.exe
