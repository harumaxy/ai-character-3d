{
  "mcpServers": {
    "comfyui": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "comfyui-mcp"],
      "env": {
        "COMFYUI_URL": "http://127.0.0.1:8188"
      }
    },
    "blender": {
      "type": "stdio",
      "command": "uvx",
      "args": ["blender-mcp@1.9.1"],
      "env": {
        "DISABLE_TELEMETRY": "true"
      }
    }
  }
}
